{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:tunnel": "expo start --tunnel",
    "start:tunnel:clear": "expo start --tunnel -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:android:clean": "expo prebuild --platform android --clean --no-install",
    "prebuild:android:preview": "set EAS_BUILD_PROFILE=preview&& expo prebuild --platform android --clean --no-install",
    "prebuild:android:production": "set EAS_BUILD_PROFILE=production&& expo prebuild --platform android --clean --no-install",
    "build:local:apk": "cd android && gradlew.bat app:assembleRelease",
    "build:local:aab": "cd android && gradlew.bat app:bundleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:apk": "npx eas build --platform android --profile preview",
    "build:aab": "npx eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.99.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^18.7.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
